# Docker Compose 主机访问端口；容器内 Express 始终监听 3000。
PORT=3000
# Three.js 地图展示使用的天地图 token。
TIANDITU_TOKEN=your_token_here

# MaxKB v2 智能体 Base URL（不含 /chat/completions）；仅后端使用。
MAXKB_BASE_URL=http://your-maxkb-host:8085/chat/api/your-application-id
# 在 MaxKB 智能体概览 → API Key 中创建。密钥只填入本地 .env，不要提交到 Git 或打包进 App。
MAXKB_API_KEY=
# 可选：单次回答最长等待毫秒数（默认 45000）。
MAXKB_TIMEOUT_MS=45000
